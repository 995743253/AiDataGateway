<Window x:Class="AiDataGateway.Desktop.MemoryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存使用率" Width="116" Height="116"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Cursor="SizeAll">
    <Window.Resources>
        <LinearGradientBrush x:Key="OverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0D233E" />
            <GradientStop Offset="1" Color="#145B8B" />
        </LinearGradientBrush>
    </Window.Resources>
    <Grid x:Name="Root" MouseLeftButtonDown="OnDragBegin" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd">
        <Ellipse Fill="{StaticResource OverlayBrush}" />
        <Path x:Name="TrackRing" Stroke="#3AFFFFFF" StrokeThickness="6.5" />
        <Path x:Name="UsageRing" Stroke="#2BBE81" StrokeThickness="6.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="PercentText" Text="0%" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="内存使用" FontSize="11" Foreground="#DAECF9" HorizontalAlignment="Center" Margin="0,2,0,0" />
            <TextBlock x:Name="DetailText" Text="正在读取" FontSize="10" Foreground="#B2CFE3" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开控制台" Click="OnOpenConsoleClick" />
            <Separator />
            <MenuItem Header="关闭内存悬浮球" Click="OnDisableClick" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
