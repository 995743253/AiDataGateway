<Window x:Class="AiDataGateway.LocalLogViewer.DetachedWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AiDataGateway.LocalLogViewer.Views"
        Title="日志详情" Width="1250" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource PageBrush}" Icon="Assets/gateway-app.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBrush" Color="White" />
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#5A6B7F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverHost" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverHost" Property="Background" Value="#F0F2F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverHost" Property="Background" Value="#E2E7EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" BasedOn="{StaticResource CaptionButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="#5A6B7F" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C40E1D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" Click="OnCloseClick" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,10,0"><TextBlock Text="↗" Foreground="{StaticResource PrimaryBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DocumentTitle" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="已从主窗体分离" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                </StackPanel>
                <Button Content="返回主窗体标签页" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ReturnToMain_Click" Margin="0"/>
            </Grid>
        </Border>
        <views:WorkspaceDocumentView Grid.Row="2" Margin="20"/>
    </Grid>
</Window>
