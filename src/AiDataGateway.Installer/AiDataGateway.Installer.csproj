<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiDataGateway.Setup</AssemblyName>
    <ApplicationIcon>..\AiDataGateway.Desktop\Assets\gateway-app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\AiDataGateway.Desktop\Assets\gateway-app.ico" Link="Assets\gateway-app.ico" />
    <Resource Include="..\AiDataGateway.Desktop\Assets\gateway-app-icon.png" Link="Assets\gateway-app-icon.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Payload\AiDataGateway-payload.zip')">
    <EmbeddedResource Include="Payload\AiDataGateway-payload.zip" LogicalName="AiDataGateway.Installer.Payload.zip" />
  </ItemGroup>
</Project>
