<Window x:Class="AiDataGateway.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDataGateway 安装程序" Width="720" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F2F6FB" Icon="/Assets/gateway-app.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border Background="#0F2745">
            <Grid Margin="28,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="/Assets/gateway-app-icon.png" Width="62" Height="62" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="AiDataGateway" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderText" Text="本地 AI 数据安全网关安装程序" Foreground="#C8DDF1" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="26,22" Background="White" CornerRadius="10" BorderBrush="#D6E1ED" BorderThickness="1" Padding="24">
            <StackPanel>
                <TextBlock x:Name="ModeTitle" Text="选择安装位置" FontSize="18" FontWeight="SemiBold" Foreground="#18324F"/>
                <TextBlock x:Name="ModeDescription" Text="程序文件与业务数据库可以分别保存。后续升级会自动沿用这些目录。" Foreground="#6B7A90" Margin="0,6,0,14"/>
                <TextBlock Text="程序安装目录" Foreground="#32445B" FontWeight="SemiBold"/>
                <Grid Margin="0,7,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox"/><Button Grid.Column="1" Content="浏览…" Click="OnBrowseInstall"/>
                </Grid>
                <TextBlock Text="数据库与密钥目录" Foreground="#32445B" FontWeight="SemiBold"/>
                <Grid Margin="0,7,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DataPathBox"/><Button x:Name="BrowseDataButton" Grid.Column="1" Content="浏览…" Click="OnBrowseData"/>
                </Grid>
                <TextBlock x:Name="DataHint" Text="gateway.db、加密密钥和审计日志保存在此目录；卸载和更新均不会删除。" Foreground="#738198" FontSize="11.5" TextWrapping="Wrap"/>
                <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Margin="0,14,0,0"/>
                <ProgressBar x:Name="InstallProgress" Height="7" Minimum="0" Maximum="100" Margin="0,20,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Foreground="#1769AA" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#D6E1ED" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button x:Name="CancelButton" Content="取消" Click="OnCancel"/>
                <Button x:Name="InstallButton" Content="安装" Click="OnInstall" Background="#1769AA" Foreground="White" BorderBrush="#1769AA"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
